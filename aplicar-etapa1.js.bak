// Aplica a Etapa 1 (periodicidade do checklist + data base das preventivas)
// Uso: copie este arquivo para a PASTA RAIZ do projeto (onde fica o .clasp.json)
//      e rode no terminal do VS Code:   node aplicar-etapa1.js
// Depois: clasp push   (ou faça commit/push no git, como de costume)
// Os arquivos alterados ganham uma cópia de segurança com extensão .bak
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const ARQUIVOS = {
 "apps/01-Model/ContratoModel.js": {
  "novo": "",
  "md5_antigo": "3aa43c09db2bac985fe0f774a75a4175"
 },
 "apps/Controller/Contrato/back/CadastroContratoBackend.js": {
  "novo": "",
  "md5_antigo": "3f03e10cd61e87acec520ca9a438cec4"
 },
 "apps/Controller/Contrato/cadastro/CadastroContratoForm.html": {
  "novo": "",
  "md5_antigo": "559271d55890751e648a9a9ba1a32663"
 },
 "apps/Controller/Contrato/cadastro/CadastroContratoFormJS.html": {
  "novo": "",
  "md5_antigo": "381bc20579e314003d73a577e30af11b"
 },
 "apps/Controller/Relatorios/back/RelatoriosBackend.js": {
  "novo": "",
  "md5_antigo": "af5275f9d40e7d413d73ddfdde4efb77"
 },
 "apps/Controller/Relatorios/front/RelatoriosJS.html": {
  "novo": "",
  "md5_antigo": "c459f3e14f4297c36cf075292bdc7843"
 },
 "apps/Helper/back/HelperPeriodicidade.js": {
  "novo": "",
  "md5_antigo": null
 }
};

const raiz = process.cwd();
if (!fs.existsSync(path.join(raiz, '.clasp.json')) && !fs.existsSync(path.join(raiz, 'appsscript.json'))) {
  console.error('Rode este script na pasta raiz do projeto (onde estão .clasp.json / appsscript.json).');
  process.exit(1);
}

let avisos = 0;
for (const [rel, info] of Object.entries(ARQUIVOS)) {
  const destino = path.join(raiz, rel);
  if (fs.existsSync(destino)) {
    const atual = fs.readFileSync(destino);
    const md5 = crypto.createHash('md5').update(atual).digest('hex');
    if (info.md5_antigo && md5 !== info.md5_antigo) {
      console.warn('AVISO: ' + rel + ' foi alterado desde a versão analisada (18/11). Ele será substituído; confira o .bak se tinha mudança sua.');
      avisos++;
    }
    fs.writeFileSync(destino + '.bak', atual);
  } else {
    fs.mkdirSync(path.dirname(destino), { recursive: true });
  }
  fs.writeFileSync(destino, Buffer.from(info.novo, 'base64'));
  console.log('OK  ' + rel);
}
console.log('\nPronto. ' + Object.keys(ARQUIVOS).length + ' arquivos aplicados' + (avisos ? ', ' + avisos + ' aviso(s) acima.' : '.'));
console.log('Lembrete: criar o cabeçalho DATA_BASE_PREVENTIVA na coluna U de tbl_contratos.');
console.log('Cópias .bak criadas ao lado de cada arquivo (o clasp push não envia .bak). Apague depois de conferir.');
